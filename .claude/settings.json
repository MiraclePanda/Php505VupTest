{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Read|Grep|Glob|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/scripts/upgrade/hooks/guard.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/upgrade/hooks/post-edit-lint.sh",
            "timeout": 120
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(scripts/upgrade/*)",
      "Bash(python3 scripts/upgrade/*)",
      "Bash(tests/characterization/*)",
      "Bash(git diff:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(iconv -f EUC-JP -t UTF-8:*)",
      "Bash(KEEP=1 *scripts/upgrade/verify.sh:*)",
      "Bash(APP_DIR=app scripts/upgrade/verify.sh:*)",
      "Bash(iconv -f CP932 -t UTF-8:*)",
      "Bash(iconv -f SHIFT_JIS -t UTF-8:*)",
      "Bash(git show:*)",
      "Bash(git -c core.quotepath=off diff:*)",
      "Read(.work/**)",
      "Grep(.work/**)"
    ]
  }
}
